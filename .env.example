# Required existing backend configuration. Keep real credentials out of Git.
GEMINI_API_KEY=
GROQ_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SCHEMA=avsuite

# Migration only, local environment; never required by the app or frontend.
# Personal access token with Database Write permission. Do not commit its value.
# SUPABASE_ACCESS_TOKEN=

# Online studio: apply migrations/001_online_studio.sql BEFORE deploying.
STUDIO_STORAGE=supabase
STUDIO_MEDIA_BUCKET=avsuite-media
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional vision model override; by default reuse the active transcription model.
GEMINI_REFRAME_MODEL=
# Same-origin frontend needs no CORS allowlist. Optional origins separated by commas.
CORS_ALLOWED_ORIGINS=

# Local files: set STUDIO_STORAGE=local and choose a persistent STUDIO_DATA_DIR.
# Auth users/plans still use the existing Supabase configuration.
# STUDIO_DATA_DIR=/absolute/path/to/studio-data
