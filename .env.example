# Required existing backend configuration. Keep real credentials out of Git.
GEMINI_API_KEY=
GROQ_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SCHEMA=avsuite

# Migration only, local environment; never required by the app or frontend.
# Personal access token with Database Write permission. Do not commit its value.
# SUPABASE_ACCESS_TOKEN=

# Online studio: apply migrations/001_online_studio.sql BEFORE deploying.
STUDIO_STORAGE=supabase
STUDIO_MEDIA_BUCKET=avsuite-media
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional lists, comma-separated; blank values use built-in alternatives.
# Text/audio/vision defaults use models with a documented free tier.
# GEMINI_MODELS=
# GEMINI_TTS_MODELS=
# Gemini image models currently have no free tier, even with rotation.
# GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-3-pro-image
# Optional preferred vision model; tries the free alternatives if it fails.
GEMINI_REFRAME_MODEL=
# GEMINI_REFRAME_MODELS=
# Same-origin frontend needs no CORS allowlist. Optional origins separated by commas.
CORS_ALLOWED_ORIGINS=

# Local files: set STUDIO_STORAGE=local and choose a persistent STUDIO_DATA_DIR.
# Auth users/plans still use the existing Supabase configuration.
# STUDIO_DATA_DIR=/absolute/path/to/studio-data

# Personal use on this machine only: localhost enters as PRO with no login and
# no Supabase (users, usage, exports index and studio live in STUDIO_DATA_DIR).
# Requests from other machines still need a session. Never set it on a deploy.
# LOCAL_PRO_MODE=1
